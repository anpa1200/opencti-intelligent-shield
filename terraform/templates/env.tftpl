# Generated by Terraform - do not edit by hand on the VM.

# === Core ===
OPENCTI_ADMIN_EMAIL=${admin_email}
OPENCTI_ADMIN_PASSWORD=${admin_password}
OPENCTI_ADMIN_TOKEN=${admin_token}
OPENCTI_BASE_URL=${base_url}

# === Secrets ===
APP__ADMIN__TOKEN=${admin_token}
APP__SECRET_KEY=${app_secret}

# === ElasticSearch ===
ELASTIC_PASSWORD=${elastic_password}

# === Redis ===
REDIS_PASSWORD=${redis_password}

# === MinIO ===
MINIO_ROOT_USER=${minio_user}
MINIO_ROOT_PASSWORD=${minio_password}

# === RabbitMQ ===
RABBITMQ_DEFAULT_USER=${rabbitmq_user}
RABBITMQ_DEFAULT_PASS=${rabbitmq_password}

# === Connector IDs (unique UUID4 per connector - NOT used for auth) ===
CONNECTOR_MITRE_TOKEN=${connector_ids.mitre}
CONNECTOR_CVE_TOKEN=${connector_ids.cve}
CONNECTOR_ALIENVAULT_TOKEN=${connector_ids.alienvault}
CONNECTOR_MALWAREBAZAAR_TOKEN=${connector_ids.malwarebazaar}
CONNECTOR_URLHAUS_TOKEN=${connector_ids.urlhaus}
CONNECTOR_FEODOTRACKER_TOKEN=${connector_ids.feodotracker}
CONNECTOR_AI_ENRICHMENT_TOKEN=${connector_ids.ai_enrichment}
CONNECTOR_IMPORT_DOCUMENT_TOKEN=${connector_ids.import_document}
CONNECTOR_THREATFOX_TOKEN=${connector_ids.threatfox}

# === External API keys ===
ALIENVAULT_API_KEY=${alienvault_api_key}
NVD_API_KEY=${nvd_api_key}
ANTHROPIC_API_KEY=${anthropic_api_key}
